# Copiar a .env.deploy (ignorado por git). Lo lee scripts/deploy-ovh.sh.
# Por defecto el asistente corre en el mismo servidor (api.guilleveron.com). Si se usa el
# Cloudflare Worker, poner acá su URL.
NUXT_PUBLIC_ASSISTANT_URL=https://api.guilleveron.com
DEPLOY_HOST=ServidorGuilleOVH
DEPLOY_DIR=/home/ubuntu/portfolio-guillermo-veron
