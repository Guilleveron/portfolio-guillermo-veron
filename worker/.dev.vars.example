# Copiar a worker/.dev.vars (ignorado por git). Solo las claves de los proveedores que uses:
# la cascada (LLM_CHAIN en wrangler.toml) salta los eslabones sin clave.
DASHSCOPE_API_KEY=            # Alibaba Model Studio (Qwen): qwen-flash, qwen3.7-flash
QWEN_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
OPENROUTER_API_KEY=           # OpenRouter: gemini-2.5-flash-lite, ling-3.0-flash
GEMINI_API_KEY=               # Google AI Studio: gemini-3.7-flash
GROQ_API_KEY=                 # Groq: openai/gpt-oss-20b
# XAI_API_KEY=                # xAI (grok-4-fast), opcional
# ANTHROPIC_API_KEY=          # Anthropic (claude-haiku-5-5), opcional
